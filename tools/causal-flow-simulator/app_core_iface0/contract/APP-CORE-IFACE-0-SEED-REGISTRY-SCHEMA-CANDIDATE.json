{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://styxsecure.org/schema/app-core-iface-0-seed-registry-v1.schema.json",
  "title": "APP-CORE-IFACE-0 canonical object seed registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryVersion",
    "status",
    "interfaceSchemaSha256",
    "positiveCarrierInventorySha256",
    "objectSchemaPointerSetSha256",
    "rowCount",
    "rows"
  ],
  "properties": {
    "registryVersion": {
      "const": "APP-CORE-IFACE-0-SEEDS-V1"
    },
    "status": {
      "enum": [
        "PRE_RATIFICATION_CANDIDATE",
        "RATIFIED"
      ]
    },
    "interfaceSchemaSha256": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "positiveCarrierInventorySha256": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "objectSchemaPointerSetSha256": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "rowCount": {
      "const": 76
    },
    "rows": {
      "type": "array",
      "minItems": 76,
      "maxItems": 76,
      "items": {
        "$ref": "#/$defs/SeedRow"
      }
    }
  },
  "$defs": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "StableId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "ObjectSchemaId": {
      "type": "string",
      "pattern": "^OBJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "RelativeRegularFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
    },
    "JsonPointer": {
      "type": "string",
      "pattern": "^(?:|/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*?)$"
    },
    "OperationV0": {
      "enum": [
        "DESCRIBE_PROFILE",
        "VALIDATE_TRANSCRIPT",
        "EVALUATE_GENESIS",
        "REPLAY_CONTEXT",
        "EVALUATE_CANDIDATE",
        "EVALUATE_EVIDENCE_UPDATE"
      ]
    },
    "SeedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectSchemaId",
        "objectSchemaPointer",
        "objectSchemaSha256",
        "carrierCaseId",
        "carrierDirection",
        "disclosureClass",
        "operation",
        "carrierFile",
        "carrierSha256",
        "carrierOctets",
        "targetJsonPointer",
        "targetCanonicalJsonSha256",
        "positiveObservationId",
        "structuralFamilyIds"
      ],
      "properties": {
        "objectSchemaId": {
          "$ref": "#/$defs/ObjectSchemaId"
        },
        "objectSchemaPointer": {
          "$ref": "#/$defs/JsonPointer"
        },
        "objectSchemaSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "carrierCaseId": {
          "$ref": "#/$defs/StableId"
        },
        "carrierDirection": {
          "enum": [
            "REQUEST",
            "RESPONSE"
          ]
        },
        "disclosureClass": {
          "enum": [
            "BLIND_INPUT",
            "WITHHELD_ORACLE"
          ]
        },
        "operation": {
          "$ref": "#/$defs/OperationV0"
        },
        "carrierFile": {
          "$ref": "#/$defs/RelativeRegularFile"
        },
        "carrierSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "carrierOctets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967275
        },
        "targetJsonPointer": {
          "$ref": "#/$defs/JsonPointer"
        },
        "targetCanonicalJsonSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "positiveObservationId": {
          "$ref": "#/$defs/StableId"
        },
        "structuralFamilyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^STR-[A-Z0-9-]+$"
          }
        }
      }
    }
  }
}
